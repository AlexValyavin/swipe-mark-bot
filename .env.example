# Telegram Bot (webhook HMAC + auth initData signature)
TELEGRAM_BOT_TOKEN=

# Telegram bot username without @ (for pairing deep links, e.g. SwipeMarkBot)
BOT_USERNAME=

# Used client-side for pairing QR/deep link; set to the same username
NEXT_PUBLIC_BOT_USERNAME=

# Firestore (только для одноразовой миграции scripts/migrate-firestore.ts)
# Inline-строка JSON сервисного аккаунта (не путь к файлу)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Supabase (новая БД)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# AES-256-GCM секрет для шифрования BYOK AI-ключей (min 16 символов)
AI_KEY_SECRET=

# Telegram ID владельца (только ему показывается блок «Диагностика»)
OWNER_TELEGRAM_ID=