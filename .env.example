# Telegram Bot (webhook HMAC + auth initData signature)
TELEGRAM_BOT_TOKEN=

# Telegram bot username without @ (for pairing deep links, e.g. SwipeMarkBot)
BOT_USERNAME=

# Used client-side for pairing QR/deep link; set to the same username
NEXT_PUBLIC_BOT_USERNAME=

# Firestore (только для одноразовой миграции scripts/migrate-firestore.ts)
# Inline-строка JSON сервисного аккаунта (не путь к файлу)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Supabase (новая БД)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# AES-256-GCM секрет для шифрования BYOK AI-ключей (min 16 символов)
AI_KEY_SECRET=

# Глобальный AI-ключ владельца (OpenRouter). Основной источник для всех пользователей.
# Если задан — пользовательские BYOK-настройки игнорируются (интерфейс скрыт).
OPENROUTER_API_KEY=
# Модель OpenRouter по умолчанию для глобального ключа
AI_MODEL=deepseek/deepseek-v4-flash-0731

# Telegram ID владельца (только ему показывается блок «Диагностика»)
OWNER_TELEGRAM_ID=

# PostHog (аналитика). EU-облако: https://eu.i.posthog.com, US: https://us.i.posthog.com
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=
# Те же значения для клиента (NEXT_PUBLIC_* попадают в бандл)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=